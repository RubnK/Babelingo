generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Level {
  id        Int      @id @default(autoincrement())
  number    Int      @unique
  questions Question[]
  category  String
  runs      Run[]
}

model Question {
  id         Int      @id @default(autoincrement())
  levelId    Int
  type       String   // "qcm", "cloze", "order", "translate"
  language   String   // ex: "en", "fr", "es"
  content    Json
  level      Level    @relation(fields: [levelId], references: [id])
  attempts   Attempt[]
}

model Run {
  id             Int       @id @default(autoincrement())
  userId         Int
  levelId        Int
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  succeeded      Boolean?
  attempts       Attempt[]
  level          Level     @relation(fields: [levelId], references: [id])
}

model Attempt {
  id         Int      @id @default(autoincrement())
  runId      Int
  questionId Int
  answer     Json
  correct    Boolean
  createdAt  DateTime @default(now())
  run        Run      @relation(fields: [runId], references: [id])
  question   Question @relation(fields: [questionId], references: [id])
}
